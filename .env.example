DB_TYPE=postgres
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=iotdb
DB_SSLMODE=require

JWT_SECRET=

PORT=8080

# TTN Plugin (optional — set TTN_ENABLED=true to activate)
TTN_ENABLED=false
TTN_MQTT_BROKER=
TTN_USERNAME=
TTN_PASSWORD=

# Embedded MQTT Broker
MQTT_BROKER_ENABLED=true
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_ENABLED=false
MQTT_BROKER_TLS_CERT=
MQTT_BROKER_TLS_KEY=

# Generic Device API
DEVICE_API_KEY=
DEVICE_AUTO_CREATE=true
